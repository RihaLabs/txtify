{
  "name": "txtify-engines",
  "private": true,
  "version": "1.0.0",
  "description": "Builds ../data-engines.js for TXTify",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --platform=browser --alias:node:zlib=./zstub.js --legal-comments=eof --outfile=../data-engines.js"
  },
  "dependencies": {
    "@irbisadm/statfmt": "0.1.1",
    "hyparquet": "1.31.4",
    "pickleparser": "0.2.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}